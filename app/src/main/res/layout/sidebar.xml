<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/studentSidebar"
    android:layout_width="230dp"
    android:layout_height="match_parent"
    android:background="#F982FF"
    android:orientation="vertical"
    android:padding="18dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">
        <ImageView
            android:id="@+id/imgProfileIcon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_profile_circle"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/dp_icon" />
        <TextView
            android:id="@+id/txtSidebarStudentName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Student Name"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtSidebarRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Student Panel"
            android:textColor="#3A3D42"
            android:textSize="13sp" />
    </LinearLayout>
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="28dp"
        android:layout_weight="1"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/menuDashboard"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_sidebar_menu_active"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="Dashboard"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/menuBrowseEvents"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="Browse Events"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/menuMyEvents"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="My Events"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/menuQrPass"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="My QR Pass"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/menuAttendance"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="Attendance"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/menuResults"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="Results"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/menuCertificates"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="Certificates"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/menuProfile"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:text="My Profile"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </ScrollView>
    <TextView
        android:id="@+id/menuLogout"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/bg_login_button"
        android:gravity="center"
        android:text="Logout"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>