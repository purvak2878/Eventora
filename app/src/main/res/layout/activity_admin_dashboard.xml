<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/norm_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtAdminWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome Admin"
            android:textColor="#230028"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Eventora Admin Panel"
            android:textColor="#303240"
            android:textSize="15sp" />

        <!-- ADMIN ACTIONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:weightSum="4">

            <Button
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="Home"
                android:textSize="11sp"
                android:padding="0dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/tabCategories"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:text="Category"
                android:textSize="11sp"
                android:padding="0dp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/tabCreateEvent"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="Create"
                android:textSize="11sp"
                android:padding="0dp"
                android:textAllCaps="false"
                android:layout_marginStart="4dp" />

            <Button
                android:id="@+id/tabManageEvents"
                android:layout_width="0dp"
                android:layout_height="45dp"
                android:layout_weight="1"
                android:text="Manage"
                android:textSize="11sp"
                android:padding="0dp"
                android:textAllCaps="false"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dashboard Overview"
            android:textColor="#111827"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="28dp" />

        <!-- Total Events Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#CCFFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/cardTotalEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Events\n\nEvents count will be shown later."
                android:textColor="#111827"
                android:textSize="17sp"
                android:padding="18dp" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Active Events Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/cardActiveEvents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Active Events\n\nActive events will be shown later."
                android:textColor="#111827"
                android:textSize="17sp"
                android:padding="18dp" />
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/btnAdminLogout"
            android:layout_width="150dp"
            android:layout_height="55dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="16dp"
            android:text="Logout"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>