<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/welcome_bg">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginTop="100dp"
            android:layout_gravity="center"
            android:contentDescription="EventoraLogo"
            android:src="@drawable/eventora_logo"/>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Eventora"
            android:textColor="#2563EB"
            android:textSize="34sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="20dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Admin Login"
            android:textColor="#111827"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="12dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Login securely using mobile number and OTP"
            android:textColor="#6B7280"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="35dp" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mobile Number"
            android:textColor="#111827"
            android:textSize="15sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />
        <EditText
            android:id="@+id/edtAdminPhone"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Enter mobile number with country code"
            android:inputType="phone"
            android:padding="14dp"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF"
            android:background="#FFFFFF" />
        <Button
            android:id="@+id/btnSendOtp"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Send OTP"
            android:textAllCaps="false"
            android:layout_marginTop="22dp" />
        <TextView
            android:id="@+id/txtBackToLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back to Student Login"
            android:textColor="#2563EB"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>