<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#FFFFFF"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="Edit Event"
                android:background="@drawable/card_bg_purple"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtEventName"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_login_input"
                android:hint="Event Name"
                android:padding="14dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF" />

            <Spinner
                android:id="@+id/spinnerEventCategory"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_login_input"
                android:padding="10dp" />

            <EditText
                android:id="@+id/edtEventDate"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_login_input"
                android:hint="Event Date"
                android:focusable="false"
                android:clickable="true"
                android:padding="14dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF" />

            <EditText
                android:id="@+id/edtEventTime"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_login_input"
                android:hint="Event Time"
                android:focusable="false"
                android:clickable="true"
                android:padding="14dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF" />

            <EditText
                android:id="@+id/edtVenue"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_login_input"
                android:hint="Venue"
                android:padding="14dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF" />

            <EditText
                android:id="@+id/edtDescription"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_login_input"
                android:hint="Description"
                android:gravity="top"
                android:padding="14dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF" />

            <EditText
                android:id="@+id/edtRegistrationFee"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_login_input"
                android:hint="Registration Fee"
                android:padding="14dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF" />

            <EditText
                android:id="@+id/edtMaxParticipants"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_login_input"
                android:hint="Maximum Participants"
                android:inputType="number"
                android:padding="14dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF" />

            <EditText
                android:id="@+id/edtImageUrl"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_login_input"
                android:hint="Image URL"
                android:padding="14dp"
                android:textColor="#111827"
                android:textColorHint="#9CA3AF" />

            <Spinner
                android:id="@+id/spinnerEventStatus"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_login_input"
                android:padding="10dp" />

            <Button
                android:id="@+id/btnUpdateEvent"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="24dp"
                android:text="Update Event"
                android:textAllCaps="false"
                android:backgroundTint="#4A00E0"
                android:textColor="@color/white" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
