<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F3F6FB">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/theme_bg"
        android:padding="16dp">
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            android:layout_marginTop="20dp"
            app:cardElevation="6dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_pink"
                android:padding="20dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Browse Events"
                    android:textColor="#FFF"
                    android:textSize="28sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Find active college events category wise"
                    android:textColor="#D7D8DC"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
           <EditText
               android:id="@+id/edtSearchEvent"
               android:layout_width="match_parent"
               android:layout_height="45dp"
               android:hint="  Search event by name"
               android:background="@drawable/bg_login_input"
               android:padding="14dp"
               android:textColor="#111827"
               android:textSize="14dp"
               android:textColorHint="#9CA3AF"
               android:drawableStart="@android:drawable/ic_menu_search"
               android:singleLine="true"
               android:layout_marginTop="18dp" />
           <Spinner
               android:id="@+id/spinnerStudentCategory"
               android:layout_width="match_parent"
               android:layout_height="45dp"
               android:background="@drawable/bg_login_input"
               android:padding="10dp"
               android:layout_marginTop="12dp" />
           <TextView
               android:id="@+id/txtEmptyEvents"
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:text="No events found"
               android:textColor="#6B7280"
               android:textSize="16sp"
               android:gravity="center"
               android:padding="20dp"
               android:background="#FFFFFF"
               android:layout_marginTop="18dp"
               android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="6dp"
            android:layout_marginTop="15dp"
            app:cardCornerRadius="24dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_pink"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Available Events"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:layout_marginStart="4dp"
                    android:textStyle="bold"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerStudentEvents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:nestedScrollingEnabled="false"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>