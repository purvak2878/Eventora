<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/welcome_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:id="@+id/imgWelcome"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="8dp"
            android:contentDescription="EventoraLogo"
            android:src="@mipmap/ic_launcher" />

        <TextView
            android:id="@+id/txtAppTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eventora"
            android:textColor="#ae10ef"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="281dp"
            android:layout_height="305dp"
            android:layout_marginTop="50dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Your collage Plug in \nwhere you plan your \nevents like a pro!"
            android:textColor="#000000"
            android:textSize="30sp"
            android:textStyle="italic" />

        <Button
            android:id="@+id/btnGetStarted"
            android:layout_width="180dp"
            android:layout_height="54dp"
            android:layout_marginTop="60dp"
            android:backgroundTint="#863ADE"
            android:text="Get Started"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

</ScrollView>
